var 
	v1: u16,
	v2: u16,
	v3[]: u16,
	v4[]: u8,
	c1: char,
	c2: char,
	i: u8;

data 
	a1[10]: u16,
	str1[]: char = "My string",
	str2[] = "My other string";

begin

	c1 := str1[0];
	
	if c1 = 'M' then
		c1 := str2[1];
	
	c2 := 'y';
	c1 := 0;
	c1 := c1 + 'A';
	c2 := c2 - 'y';
	c2 := c2 & 'z';
	c2 := c2 | 'q';
	c1 := c1 ^ 'A';

	v1 := 1024;
	v2 := 1024;
	i := 1;
	v4 := @i;
	v3 := @v2;

	v1 := a1[0];
	v1 := a1[i];
	v3[] := v1;
	v3[] := a1[i];

	inc v1;
	inc v3;
	inc v4;
	inc a1[1];
	inc a1[i];

	dec v1;
	dec v3;
	dec v4;
	dec a1[1];
	dec a1[i];

	shl v1;
	shl v3;
	shl v4;
	shl a1[1];
	shl a1[i];

	shr v1;
	shr v3;
	shr v4;
	shr a1[1];
	shr a1[i];

	rol v1;
	rol v3;
	rol v4;
	rol a1[1];
	rol a1[i];

	ror v1;
	ror v3;
	ror v4;
	ror a1[1];
	ror a1[i];

	add16 v1 v2;
	add16 v1 255;
	add16 v1 2048;
	add16 v1 $FF;
	add16 v1 $1FF;
	add16 v1 $10FF;
	add16 v1 v3;
	add16 v1 v3[];
	add16 v1 a1[0];
	add16 v1 a1[i];

	add16 v3[] v2;
	add16 v3[] 255;
	add16 v3[] 2048;
	add16 v3[] $FF;
	add16 v3[] $1FF;
	add16 v3[] $10FF;
	add16 v3[] a1[0];
	add16 v3[] a1[i];

	add16 a1[1] v2;
	add16 a1[1] 255;
	add16 a1[1] 2048;
	add16 a1[1] $FF;
	add16 a1[1] $1FF;
	add16 a1[1] $10FF;
	add16 a1[1] v3[];

	add16 a1[i] v2;
	add16 a1[i] 255;
	add16 a1[i] 2048;
	add16 a1[i] $FF;
	add16 a1[i] $1FF;
	add16 a1[i] $10FF;
	add16 a1[i] v3[];

	sub16 v1 v2;
	sub16 v1 255;
	sub16 v1 2048;
	sub16 v1 $FF;
	sub16 v1 $1FF;
	sub16 v1 $10FF;
	sub16 v1 v3;
	sub16 v1 v3[];
	sub16 v1 a1[0];
	sub16 v1 a1[i];

	sub16 v3[] v2;
	sub16 v3[] 255;
	sub16 v3[] 2048;
	sub16 v3[] $FF;
	sub16 v3[] $1FF;
	sub16 v3[] $10FF;
	sub16 v3[] a1[0];
	sub16 v3[] a1[i];

	sub16 a1[1] v2;
	sub16 a1[1] 255;
	sub16 a1[1] 2048;
	sub16 a1[1] $FF;
	sub16 a1[1] $1FF;
	sub16 a1[1] $10FF;
	sub16 a1[1] v3[];

	sub16 a1[i] v2;
	sub16 a1[i] 255;
	sub16 a1[i] 2048;
	sub16 a1[i] $FF;
	sub16 a1[i] $1FF;
	sub16 a1[i] $10FF;
	sub16 a1[i] v3[];

	and16 v1 v2;
	and16 v1 255;
	and16 v1 2048;
	and16 v1 $FF;
	and16 v1 $1FF;
	and16 v1 $10FF;
	and16 v1 v3;
	and16 v1 v3[];
	and16 v1 a1[0];
	and16 v1 a1[i];

	and16 v3[] v2;
	and16 v3[] 255;
	and16 v3[] 2048;
	and16 v3[] $FF;
	and16 v3[] $1FF;
	and16 v3[] $10FF;
	and16 v3[] a1[0];
	and16 v3[] a1[i];

	and16 a1[1] v2;
	and16 a1[1] 255;
	and16 a1[1] 2048;
	and16 a1[1] $FF;
	and16 a1[1] $1FF;
	and16 a1[1] $10FF;
	and16 a1[1] v3[];

	and16 a1[i] v2;
	and16 a1[i] 255;
	and16 a1[i] 2048;
	and16 a1[i] $FF;
	and16 a1[i] $1FF;
	and16 a1[i] $10FF;
	and16 a1[i] v3[];

	or16 v1 v2;
	or16 v1 255;
	or16 v1 2048;
	or16 v1 $FF;
	or16 v1 $1FF;
	or16 v1 $10FF;
	or16 v1 v3;
	or16 v1 v3[];
	or16 v1 a1[0];
	or16 v1 a1[i];

	or16 v3[] v2;
	or16 v3[] 255;
	or16 v3[] 2048;
	or16 v3[] $FF;
	or16 v3[] $1FF;
	or16 v3[] $10FF;
	or16 v3[] a1[0];
	or16 v3[] a1[i];

	or16 a1[1] v2;
	or16 a1[1] 255;
	or16 a1[1] 2048;
	or16 a1[1] $FF;
	or16 a1[1] $1FF;
	or16 a1[1] $10FF;
	or16 a1[1] v3[];

	or16 a1[i] v2;
	or16 a1[i] 255;
	or16 a1[i] 2048;
	or16 a1[i] $FF;
	or16 a1[i] $1FF;
	or16 a1[i] $10FF;
	or16 a1[i] v3[];


	eor16 v1 v2;
	eor16 v1 255;
	eor16 v1 2048;
	eor16 v1 $FF;
	eor16 v1 $1FF;
	eor16 v1 $10FF;
	eor16 v1 v3;
	eor16 v1 v3[];
	eor16 v1 a1[0];
	eor16 v1 a1[i];

	eor16 v3[] v2;
	eor16 v3[] 255;
	eor16 v3[] 2048;
	eor16 v3[] $FF;
	eor16 v3[] $1FF;
	eor16 v3[] $10FF;
	eor16 v3[] a1[0];
	eor16 v3[] a1[i];

	eor16 a1[1] v2;
	eor16 a1[1] 255;
	eor16 a1[1] 2048;
	eor16 a1[1] $FF;
	eor16 a1[1] $1FF;
	eor16 a1[1] $10FF;
	eor16 a1[1] v3[];

	eor16 a1[i] v2;
	eor16 a1[i] 255;
	eor16 a1[i] 2048;
	eor16 a1[i] $FF;
	eor16 a1[i] $1FF;
	eor16 a1[i] $10FF;
	eor16 a1[i] v3[];

	cmp16 v1 v2;
	cmp16 v1 255;
	cmp16 v1 2048;
	cmp16 v1 $FF;
	cmp16 v1 $1FF;
	cmp16 v1 $10FF;
	cmp16 v1 v3;
	cmp16 v1 v3[];
	cmp16 v1 a1[0];
	cmp16 v1 a1[i];

	cmp16 v3[] v2;
	cmp16 v3[] 255;
	cmp16 v3[] 2048;
	cmp16 v3[] $FF;
	cmp16 v3[] $1FF;
	cmp16 v3[] $10FF;
	cmp16 v3[] a1[0];
	cmp16 v3[] a1[i];

	cmp16 a1[1] v2;
	cmp16 a1[1] 255;
	cmp16 a1[1] 2048;
	cmp16 a1[1] $FF;
	cmp16 a1[1] $1FF;
	cmp16 a1[1] $10FF;
	cmp16 a1[1] v3[];

	cmp16 a1[i] v2;
	cmp16 a1[i] 255;
	cmp16 a1[i] 2048;
	cmp16 a1[i] $FF;
	cmp16 a1[i] $1FF;
	cmp16 a1[i] $10FF;
	cmp16 a1[i] v3[];

end.



